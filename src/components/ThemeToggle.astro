---
---
<button
    type="button"
    class="theme-toggle text-mga-gray hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 transition-colors duration-200"
    aria-label="Toggle Dark Mode"
>
    <svg
        class="theme-toggle-dark-icon hidden w-5 h-5"
        fill="currentColor"
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg"
    >
        <path
            d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
        ></path>
    </svg>
    <svg
        class="theme-toggle-light-icon hidden w-5 h-5"
        fill="currentColor"
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg"
    >
        <path
            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
    </svg>
</button>

<script>
    function initTheme() {
        const themeToggleBtn = document.querySelectorAll('.theme-toggle');
        
        // Update all buttons' icons based on current theme
        function updateIcons() {
            const isDark = document.documentElement.classList.contains('dark');
            document.querySelectorAll('.theme-toggle-dark-icon').forEach(el => {
                isDark ? el.classList.add('hidden') : el.classList.remove('hidden');
            });
            document.querySelectorAll('.theme-toggle-light-icon').forEach(el => {
                isDark ? el.classList.remove('hidden') : el.classList.add('hidden');
            });
        }

        updateIcons();

        themeToggleBtn.forEach(btn => {
            btn.addEventListener('click', function() {
                // Toggle theme class
                if (document.documentElement.classList.contains('dark')) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('color-theme', 'light');
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('color-theme', 'dark');
                }
                
                // Update all icons in all instances
                updateIcons();
            });
        });
    }

    // Run on page load
    initTheme();

    // Re-run on View Transitions if used
    document.addEventListener('astro:after-swap', initTheme);
</script>
