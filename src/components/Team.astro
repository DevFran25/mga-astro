---
const team = [
    {
        name: "Manuel German Aquino Trujillo",
        role: "Gerente General",
        desc: "Ingeniero Mecánico Electricista, con 21 años de experiencia profesional en el sector Eléctrico, de las cuales 17 se encuentra trabajando en el campo de la Electrificación Rural. Con experiencia en Gestión de Proyectos, Liquidación de Obras, Planeamiento, Residencia de Obras, Supervisión y Control de calidad de Obras en el Sector Eléctrico.",
        image: "/assets/img/team/manuel.png",
    },
    {
        name: "Fiorela Mariana Vilela Quispe",
        role: "Gerente Comercial",
        desc: "Amplia experiencia en la planificación, dirección y ejecución de estrategias comerciales orientadas al crecimiento de ventas y expansión de mercado. Especialista en liderazgo de equipos de alto desempeño, desarrollo de canales de distribución, negociación con clientes clave y gestión de indicadores comerciales",
        image: "/assets/img/team/fiorela.png",
    },
    {
        name: "Carlos Alberto Lluncor Bartra",
        role: "Director de Proyectos",
        desc: "Ingeniero Mecánico Electricista egresado de la Universidad Nacional Pedro Ruiz Gallo de Lambayeque Especialista en Identificación, Formulación y Evaluación de Proyectos y Especialista en Ingeniería Ambiental Egresado de la Maestría en Ciencias con mención en Ingeniería Ambiental de la Escuela de Postgrado de la U.N.P.R.G. – V Promoción",
        image: "/assets/img/team/carlos.png",
    },
    {
        name: "Javier Eduardo Jabo Abad",
        role: "Especialista en Energía",
        desc: "Ingeniero Mecánico Electricista egresado de la Universidad Nacional Pedro Ruiz Gallo de Lambayeque, profesional con experiencia en gestión, operaciones, mantenimiento y supervisión en el sector eléctrico e industrial, así como también en el desarrollo de proyectos. ",
        image: "/assets/img/team/javier.png",
    },
    {
        name: "Sheila Cruz Ramos Inga",
        role: "Especialista BIM",
        desc: "Ingeniero Civil egresada de la Universidad de Piura (UDEP), experiencia como coordinador BIM, supervisor BIM, BIM manager ha elaborado y/o gestionando modelos 3D federados, elaborando planes de ejecución BIM (BEP), utilizando entorno de Datos Comunes (CDE) y/o implementando BIM en proyectos de edificaciones, infraestructura y/o industriales",
        image: "/assets/img/team/sheila.png",
    },
    {
        name: "Luz Elizabeth Pintado Carrasco",
        role: "Jefe del Departamento de Logística",
        desc: "Bachiller en Ingeniería Industrial de la Universidad Tecnológica del Perú (UTP), experiencia en análisis de productividad, control de costos y gestión de recursos para incrementar la eficiencia organizacional",
        image: "/assets/img/team/luz.png",
    },
];
---

<section id="equipo" class="py-20 bg-white border-t border-slate-100">
    <div class="w-full max-w-7xl mx-auto px-4">
        <div class="text-center mb-16 max-w-3xl mx-auto">
            <span
                class="text-white font-bold tracking-wider uppercase text-xs bg-mga-blue px-3 py-1 rounded-full shadow-md"
                >Talento Humano</span
            >
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-4 mb-4">
                Nuestro Equipo
            </h2>
            <p class="text-slate-600 text-base max-w-xl mx-auto">
                Profesionales comprometidos con el éxito de cada proyecto.
            </p>
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 max-w-5xl mx-auto"
        >
            {
                team.map((member) => (
                    <div class="group text-center p-6 rounded-2xl border border-slate-100 bg-white hover:border-mga-blue hover:shadow-xl hover:shadow-mga-blue/10 hover:-translate-y-1 transition-all duration-300">
                        <div class="relative w-32 h-32 mx-auto mb-6">
                            <div class="absolute inset-0 rounded-full bg-blue-100 scale-100 group-hover:scale-110 transition-transform duration-300" />
                            <img
                                src={member.image}
                                alt={member.name}
                                class="w-full h-full object-cover rounded-full border-2 border-mga-orange shadow-md relative z-10 grayscale group-hover:grayscale-0 transition-all duration-500"
                            />
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-mga-blue transition-colors">
                            {member.name}
                        </h3>
                        <span class="text-mga-orange font-bold text-xs uppercase tracking-wide block mb-3">
                            {member.role}
                        </span>
                        <p class="text-slate-500 text-sm leading-relaxed border-t border-slate-50 pt-3 text-center max-w-xs mx-auto">
                            {member.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
